[Unit]
Description=DSA GOT daily timer (A股交易日 13:20 CST 跑全链路)

[Timer]
# 只在工作日触发；节假日由 GOT 内部 is_market_open() 跳过并以 0 退出
# 13:20 = 盘中（午后开盘后）：GOT 会以 bar_complete=false 出快照决策，
# 报告自动标注「价格与止损基于盘中快照，非收盘价」。要收盘价须改到 15:00 之后。
OnCalendar=Mon..Fri 13:20
# 刻意不设 Persistent：错过就跳过，避免开机补跑在任意时点用不完整 bar 出决策。
Unit=dsa-got.service

[Install]
WantedBy=timers.target
