# ==================== Phase 6-1 盘中 0→1 确认闸门 ====================
# 三时点（0926/1125/1445）纯规则判定当日 GOT 候选，旁挂影子节点（Node 8），
# 产物落 data/got_daily/YYYYMMDD/intraday/，零决策影响、零 LLM。
# 触发：python main.py --got-intraday --intraday-time {0926|1125|1445}（盘中实时跑，
# 收盘补跑产生 I5/I6 失真；影子期样本仅计跑满三时点的交易日）。
# INTRADAY_GATE_ENABLED：总开关，缺省 false（6-2 影子运营才翻 true）
# INTRADAY_GATE_SHADOW：影子模式，缺省 true。
#   ⚠️ 6-4 转正前禁止置 false（一票否决线：影子期 I1-I6 双达标 + 负责人批准
#   才允许实盘消费判定；写侧另有防御性拦载兜底）。
# INTRADAY_GATE_TOPN：每时点轮询候选数上限（composite_score 降序截断），缺省 8。
# INTRADAY_GATE_ENABLED=false
# INTRADAY_GATE_SHADOW=true
# INTRADAY_GATE_TOPN=8
# 判据阈值（影子期校准用，初值见实施稿 §2；一般不动）
# INTRADAY_GAP_THRESHOLD_PCT=3.0
# INTRADAY_PULLBACK_THRESHOLD_PCT=2.0
# INTRADAY_IMBALANCE_THRESHOLD=0.15
# INTRADAY_SEAL_DECAY_THRESHOLD=0.5
